# Plantilla de configuración.
# Lo más fácil es NO editar esto a mano: ejecutá  npm run setup  y se crea el .env solo.
# ⚠️ Nunca pongas datos reales en este archivo: se comparte con el código.

NEGOCIO_NOMBRE=Mi Negocio
PORT=3000
# development | production (en production las cookies solo viajan por HTTPS)
NODE_ENV=development

# Conexión a MongoDB
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017/turnos_pymes
# Atlas (ejemplo):
# MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxx.mongodb.net/turnos_pymes?retryWrites=true&w=majority

# Zona horaria del negocio (por defecto Argentina)
# TZ=America/Argentina/Buenos_Aires

# Horario de atención
HORA_APERTURA=09:00
HORA_CIERRE=18:00
DURACION_TURNO_MIN=30
# 0=domingo ... 6=sábado
DIAS_LABORABLES=1,2,3,4,5,6

# Acceso al panel admin (los genera "npm run setup"; la contraseña se guarda cifrada)
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Horas que dura la sesión del admin
# SESSION_HOURS=8
